{
  "name": "@draigara/forge",
  "version": "0.1.0-preview.2",
  "description": "Low-friction onboarding for Draigara Forge and Microsoft APM",
  "type": "module",
  "bin": {
    "forge": "dist/forge.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "TRADEMARKS.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "check": "npm run typecheck && npm run build && npm run test",
    "dev": "node --import tsx src/forge.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Draigara/draigara-forge-cli.git"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "chalk": "5.6.2",
    "commander": "15.0.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsdown": "0.21.5",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
