{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.draigara.com/forge/bridge/v1/envelope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "requestId",
    "ok",
    "result",
    "warnings",
    "error"
  ],
  "properties": {
    "protocolVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "ok": {
      "type": "boolean"
    },
    "result": {},
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "null"
          },
          "error": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "warning": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "remediation",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^FORGE_[A-Z0-9_]+$"
        },
        "message": {
          "type": "string"
        },
        "remediation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": true
            }
          ]
        },
        "details": {
          "type": "object"
        }
      }
    }
  }
}
