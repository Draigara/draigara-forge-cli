<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>forge</AssemblyName>
    <RootNamespace>Draigara.Forge</RootNamespace>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <OptimizationPreference>Size</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseAppHost>true</UseAppHost>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Version>0.1.0-local</Version>
    <ForgeCliChannel Condition="'$(ForgeCliChannel)' == ''">local</ForgeCliChannel>
    <ForgeCommit Condition="'$(ForgeCommit)' == ''">unknown</ForgeCommit>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ForgeCliChannel" Value="$(ForgeCliChannel)" />
    <AssemblyMetadata Include="ForgeCommit" Value="$(ForgeCommit)" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
</Project>
